                  "startLine": 71,
                  "endLine": 77,
                  "snippet": {
                    "text": "  it('documents every exit code in the help text', () => {\n    const exitCodeBlock = helpText().split('\\nExit codes:\\n')[1];\n    assert.ok(exitCodeBlock, 'Exit codes block');\n\n    for (const code of Object.values(EXIT)) {\n      assert.match(exitCodeBlock, new RegExp(`^ {2}${code} {2}`, 'm'), `exit code ${code}`);\n    }"
                  }
                }
              }
            }
