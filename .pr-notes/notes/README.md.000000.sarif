                    "text": "```console\n$ pueue-wait-cond 0 --json --until 'test -f /tmp/ready' | jq -r '.outcome, .elapsedMs'\nuntil\n1122\n```\n\n```json\n{\n  \"outcome\": \"reached\",\n  \"exitCode\": 0,\n  \"elapsedMs\": 13,\n  \"iterations\": 1,\n  \"targetStatus\": \"done\",\n  \"group\": null,\n  \"tasks\": [\n    { \"id\": 0, \"group\": \"default\", \"label\": null, \"command\": \"true\",\n      \"status\": \"Done\", \"result\": \"Success\", \"exitCode\": null }\n  ],\n  \"pendingIds\": [],\n  \"failedIds\": [],\n  \"condition\": null,\n  \"unknownIds\": []\n}"
                  }
