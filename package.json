{
  "name": "pueue-wait-cond",
  "version": "0.1.0",
  "description": "pueue wait with timeouts and --until / --while script conditions",
  "keywords": [
    "pueue",
    "wait",
    "queue",
    "cli",
    "task-queue",
    "condition",
    "timeout"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "pueue-wait-cond": "bin/pueue-wait-cond.js"
  },
  "main": "./dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "types": "./dist/src/index.d.ts",
  "files": [
    "bin/",
    "dist/src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage .tmp-coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --import tsx --test \"test/unit/*.test.ts\"",
    "pretest:e2e": "npm run build",
    "test:e2e": "node --import tsx --test --test-concurrency=1 \"test/e2e/*.test.ts\"",
    "coverage": "npm run coverage:clean && npm run coverage:unit && npm run coverage:e2e && npm run coverage:report",
    "coverage:clean": "rm -rf coverage .tmp-coverage",
    "coverage:unit": "c8 --config .c8rc.json --temp-directory .tmp-coverage npm run test:unit",
    "coverage:e2e": "c8 --config .c8rc.json --temp-directory .tmp-coverage npm run test:e2e",
    "coverage:report": "c8 report --config .c8rc.json --temp-directory .tmp-coverage --reporter text --reporter lcov --reporter html",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "c8": "^10.1.3",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
