                "region": {
                  "startLine": 24,
                  "endLine": 28,
                  "snippet": {
                    "text": "\n- Use American English in all repository-authored prose, including documentation, user-facing output, source comments, test names, commit messages, and workflow guidance. Prefer forms such as `behavior`, `color`, `normalize`, `serialize`, and `recognize`. Preserve another spelling only when an external API, command output, identifier, proper name, or verbatim quotation requires it.\n\n<!-- hotsheet:begin section=testing-philosophy v=2 -->\n## Testing Philosophy"
                  }
                }
              }
            }
